{
	auto_https off
}

:8080 {
	handle /server/* {
		respond 404
	}

	handle /.git* {
		respond 404
	}

	handle /harbor/* {
		uri strip_prefix /harbor
		reverse_proxy 127.0.0.1:8001
	}

	handle /stream/* {
		uri strip_prefix /stream
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	handle {
		root * /Users/yaniv.vainer/workspace/projects/radio-vainer
		file_server
	}
}
