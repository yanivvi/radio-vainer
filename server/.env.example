# Override the station password. The studio asks for this same value.
# Letters, numbers, and hyphens only.
SOURCE_PASSWORD=changeme

# This computer's address on the local network. The phone opens https://this-address.
# A .local name works here when the phone can open it.
SITE_ADDRESS=192.168.1.20

# Public Tailscale name. Requests for the studio send-in on this host are refused.
PUBLIC_HOST=your-computer.your-tailnet.ts.net
